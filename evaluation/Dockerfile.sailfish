# syntax=docker/dockerfile:1

FROM --platform=linux/amd64 holmessherlock/sailfish:latest

ENV RESULTS_DIR=/results

COPY contracts_dataset/dataset_sailfish/ /dataset/

COPY evaluation/run_sailfish.sh /usr/local/bin/run_sailfish.sh
RUN chmod +x /usr/local/bin/run_sailfish.sh

ENTRYPOINT ["/usr/local/bin/run_sailfish.sh"]
CMD ["/dataset"]